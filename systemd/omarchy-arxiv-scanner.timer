[Unit]
Description=Run arXiv new-submissions scan every morning
# Managed-By: prometheus.arxiv-quantum — install.sh/uninstall.sh check for
# this line before overwriting or removing this unit, so a same-named unit
# from something else is never touched. Do not remove this line by hand.
# (save-settings.sh only ever rewrites the OnCalendar= line below, so your
# scan-time customization survives regardless.)

[Timer]
OnCalendar=*-*-* 07:30:00
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target

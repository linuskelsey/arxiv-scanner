[Unit]
Description=arXiv catch-up scan if the last one is stale (Omarchy plugin)
# Managed-By: prometheus.arxiv-scanner — install.sh/uninstall.sh check for
# this line before overwriting or removing this unit, so a same-named unit
# from something else is never touched. Do not remove this line by hand.

[Service]
Type=oneshot
# Backstop: the fetches are size-capped, but never let a runaway helper
# take the session with it.
MemoryMax=512M
ExecStart=%h/.config/omarchy/plugins/prometheus.arxiv-scanner/bin/poll.py --if-stale
